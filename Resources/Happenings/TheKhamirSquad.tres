[gd_resource type="Resource" script_class="Happening" format=3 uid="uid://cjywrm3yoyv76"]

[ext_resource type="Script" uid="uid://d4i4t1fv5kyee" path="res://Scenes/Map/MapSpot/Happenings/HappeningStage.gd" id="1_aoe7e"]
[ext_resource type="Script" uid="uid://dambs06xmyhgk" path="res://Scenes/Map/MapSpot/Happenings/HappeningOption.gd" id="2_13uso"]
[ext_resource type="Script" uid="uid://ii12ceb6fgif" path="res://Scenes/Map/MapSpot/Happenings/StringHappeningOption.gd" id="3_afxht"]
[ext_resource type="Script" uid="uid://cj6lgkawdqkd8" path="res://Scenes/Map/MapSpot/Happenings/HappeningText.gd" id="4_r1uac"]
[ext_resource type="Script" uid="uid://dje5vrjyps8mt" path="res://Scenes/Map/MapSpot/Happenings/Happening.gd" id="6_jxpfh"]

[sub_resource type="Resource" id="Resource_afxht"]
script = ExtResource("3_afxht")
OptionName = "Accept"
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_qybly"]
script = ExtResource("3_afxht")
OptionName = "Decline"
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_wdjid"]
script = ExtResource("4_r1uac")
Text = "\"But you wouldn't really call me here to kill me, that's not how the Khamirs do buisness, they aint this sneaky.\""

[sub_resource type="Resource" id="Resource_jxpfh"]
script = ExtResource("4_r1uac")
Text = "You barely see a smile pop up in her face, all because of the glistenning white teeth that shine within it."

[sub_resource type="Resource" id="Resource_8whtd"]
script = ExtResource("4_r1uac")
Text = "\"You are right captain, we did have a consideration about it but you might have something that we want. And killing you guaranties us this loss.\""

[sub_resource type="Resource" id="Resource_rubxt"]
script = ExtResource("4_r1uac")
Text = "You dont talk expecting her to continue..."

[sub_resource type="Resource" id="Resource_ql2ql"]
script = ExtResource("4_r1uac")
Text = "\"You see captain alot of ruckus has been raised inside the empires corridors, the big heads dont have the spine to say it but you stress them.\""

[sub_resource type="Resource" id="Resource_r6sam"]
script = ExtResource("4_r1uac")
Text = "\"Your campaign has barely started but you've reached further than any other that has tried. You show premise that is beyond what one would expect from our times.\""

[sub_resource type="Resource" id="Resource_obler"]
script = ExtResource("4_r1uac")
Text = "\"You might know our history but you probably dont know the whole of it. The decision to join the empire was taken by one of the weakest leaders our tribe ever had.\""

[sub_resource type="Resource" id="Resource_qugx0"]
script = ExtResource("4_r1uac")
Text = "\"Ever since that day an internal dispute that was caused thanks to the contract that this man had put us on that's been going on without an end in sight.\""

[sub_resource type="Resource" id="Resource_ugrmb"]
script = ExtResource("4_r1uac")
Text = "\"The Khamirs will one day be free captain...\" As you hear the phrase the hair on the back of your neck stand up. She is emanating power and it's slowly filling up the whole room.\""

[sub_resource type="Resource" id="Resource_254ss"]
script = ExtResource("4_r1uac")
Text = "You are once again finding it hard to speak. Your tungue has picked up some weight and by now its impossible to move. You force yourself and you can just about take out a few words."

[sub_resource type="Resource" id="Resource_r0vhn"]
script = ExtResource("4_r1uac")
Text = "\"Through the transmission earlier you called me Khoma. What is the meaning of that word.\""

[sub_resource type="Resource" id="Resource_m4k7n"]
script = ExtResource("4_r1uac")
Text = "\"Butcher\" is the only word that leaves her mouth, it seemed like she was waiting for you to ask and is almost relieved to have finally let that word out."

[sub_resource type="Resource" id="Resource_qmqu4"]
script = ExtResource("4_r1uac")
Text = "\"That's what they are calling you captain. You can understand now why i went through all this trouble to meet you.\""

[sub_resource type="Resource" id="Resource_dqvk5"]
script = ExtResource("4_r1uac")
Text = "\"This is taking too long unfortunately and our meeting is prone to get leaked if we dont hurry and get to the gist of the matter.\""

[sub_resource type="Resource" id="Resource_ghnei"]
script = ExtResource("4_r1uac")
Text = "\"We would like to assist you in your journey to liberate Dormak, and with that liberate the Khamirs.\" The whole room falls silent... \"What say you?\""

[sub_resource type="Resource" id="Resource_13uso"]
script = ExtResource("1_aoe7e")
Texts = Array[ExtResource("4_r1uac")]([SubResource("Resource_wdjid"), SubResource("Resource_jxpfh"), SubResource("Resource_8whtd"), SubResource("Resource_rubxt"), SubResource("Resource_ql2ql"), SubResource("Resource_r6sam"), SubResource("Resource_obler"), SubResource("Resource_qugx0"), SubResource("Resource_ugrmb"), SubResource("Resource_254ss"), SubResource("Resource_r0vhn"), SubResource("Resource_m4k7n"), SubResource("Resource_qmqu4"), SubResource("Resource_dqvk5"), SubResource("Resource_ghnei")])
Options = Array[ExtResource("2_13uso")]([SubResource("Resource_afxht"), SubResource("Resource_qybly")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_aoe7e"]
script = ExtResource("3_afxht")
StringReply = "\"I must admit, i accepted your request before i figured out who you were. Had i had a better memory this meeting would have probably not been made.\""
OptionName = "Respond"
BranchContinuation = Array[ExtResource("1_aoe7e")]([SubResource("Resource_13uso")])
WorldviewCheck = 1
CheckDifficulty = 40
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_joq5j"]
script = ExtResource("4_r1uac")
Text = "Is this a bad idea ? Suddenly it comes to you. The armor... That's Khamir armor. They Khamirs have been allied to the empire for decades now. Sudennly this is starting to feel like a bad idea."

[sub_resource type="Resource" id="Resource_klaoi"]
script = ExtResource("4_r1uac")
Text = "As the ship touches the port you snap back to reality. You feel the urge to order the ship to launch again, but the crew is looking at you. They probably figured out what you did as well."

[sub_resource type="Resource" id="Resource_2814q"]
script = ExtResource("4_r1uac")
Text = "You make your way to the exit and to the far side of the port you see the Khamir ship. Sharp edjes come out of its body, if you saw it on the sky you would think its alien, no gaps apear to its surface, only the door that you see open as you aproach."

[sub_resource type="Resource" id="Resource_0118k"]
script = ExtResource("4_r1uac")
Text = "2 huge soldiers come out, they must be 2-3 heads above you. The stand at the edge of the opened gate. They bow and signal you to step into the ship."

[sub_resource type="Resource" id="Resource_u2mhg"]
script = ExtResource("4_r1uac")
Text = "As you make it inside you are struck by the heavy smell of incence, and hear a faint music towards the deeper parts of the ship."

[sub_resource type="Resource" id="Resource_kb178"]
script = ExtResource("4_r1uac")
Text = "You follow the music and are eventually met with the captain of the ship. The woman you spoke with through the radio."

[sub_resource type="Resource" id="Resource_n46ex"]
script = ExtResource("4_r1uac")
Text = "You see her slowly stand up to welcome you. She stands from the pillow she sits on the floor. The elegance of her moves makes you forget for a second that this woman is one of the most skilled murderers the planet has probably seen in years."

[sub_resource type="Resource" id="Resource_itdjc"]
script = ExtResource("4_r1uac")
Text = "\"My honor to finally get to meet you captain.\" She is wearing a helmet but you can feel her eyes piercing through yours."

[sub_resource type="Resource" id="Resource_8otp1"]
script = ExtResource("4_r1uac")
Text = "Any weakness here will be taken advantage of you think. You need to ignore your shaking knees and act like the person she expects you to be. "

[sub_resource type="Resource" id="Resource_aj65w"]
script = ExtResource("4_r1uac")
Text = "You take a big breath and say...."

[sub_resource type="Resource" id="Resource_udrsw"]
script = ExtResource("1_aoe7e")
Texts = Array[ExtResource("4_r1uac")]([SubResource("Resource_joq5j"), SubResource("Resource_klaoi"), SubResource("Resource_2814q"), SubResource("Resource_0118k"), SubResource("Resource_u2mhg"), SubResource("Resource_kb178"), SubResource("Resource_n46ex"), SubResource("Resource_itdjc"), SubResource("Resource_8otp1"), SubResource("Resource_aj65w")])
Options = Array[ExtResource("2_13uso")]([SubResource("Resource_aoe7e")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_ee684"]
script = ExtResource("3_afxht")
StringReply = "\"You honor me.\" She and the people that stand around her get up and bow. \"Lets both land and i'll be expecting you ...\" The transmission ends..."
OptionName = "Accept"
BranchContinuation = Array[ExtResource("1_aoe7e")]([SubResource("Resource_udrsw")])
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_joh2p"]
script = ExtResource("4_r1uac")
Text = "The transmission ends."

[sub_resource type="Resource" id="Resource_r1uac"]
script = ExtResource("1_aoe7e")
Texts = Array[ExtResource("4_r1uac")]([SubResource("Resource_joh2p")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_72crc"]
script = ExtResource("3_afxht")
StringReply = "\"You make me sad captain. We could have done great thing together.\""
OptionName = "Decline"
BranchContinuation = Array[ExtResource("1_aoe7e")]([SubResource("Resource_r1uac")])
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_r8rca"]
script = ExtResource("4_r1uac")
Text = "While landing the ship a request for a transmision comes from a nearby fleet. \"Incomming transmission Captain you hear the radio operator as he looks back at you expecting an answer."

[sub_resource type="Resource" id="Resource_20x2d"]
script = ExtResource("4_r1uac")
Text = "You make a shallow nod at him and he allows the transmission come through. It is a woman, you recognise the armor she is wearing but you cant put your finger to it."

[sub_resource type="Resource" id="Resource_dfpp4"]
script = ExtResource("4_r1uac")
Text = "Her voice comes through, its rough but still keeps some of its elegance. \"Hmm, what a surprise, never expected you do be this young.\""

[sub_resource type="Resource" id="Resource_no341"]
script = ExtResource("4_r1uac")
Text = "What would she mean by that? She knows me ? ...."

[sub_resource type="Resource" id="Resource_rme1h"]
script = ExtResource("4_r1uac")
Text = "\"I've heard of you, i've came here with a purpose of meeting you in person. Would you accept an invitation to our ship Khoma?\""

[sub_resource type="Resource" id="Resource_3ealn"]
script = ExtResource("1_aoe7e")
Texts = Array[ExtResource("4_r1uac")]([SubResource("Resource_r8rca"), SubResource("Resource_20x2d"), SubResource("Resource_dfpp4"), SubResource("Resource_no341"), SubResource("Resource_rme1h")])
Options = Array[ExtResource("2_13uso")]([SubResource("Resource_ee684"), SubResource("Resource_72crc")])

[resource]
script = ExtResource("6_jxpfh")
HappeningName = "The Khamir squad"
Stages = Array[ExtResource("1_aoe7e")]([SubResource("Resource_3ealn")])
Special = true
CrewRecruit = true
