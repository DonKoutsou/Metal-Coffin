[sub_resource type="Resource" id="Resource_hrxfo"]
script = ExtResource("4_dh2fs")
StringReply = "\"Hahahaha, no you will not. Not with that atitude, what happened to your spine? You expect to win a war with hope... Get out of here, i've waisted enough time on you"
OptionName = "We will do the best we can"
BranchContinuation = Array[ExtResource("2_4o3s8")]([SubResource("Resource_0t6kv")])
Branch = SubResource("Resource_0t6kv")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_ug15j"]
script = ExtResource("4_fnrm0")
Text = "\"Are you sirius about reaching Dormak?\""

[sub_resource type="Resource" id="Resource_uvn1n"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_ug15j")])
Options = Array[ExtResource("3_fnrm0")]([SubResource("Resource_jek72"), SubResource("Resource_hrxfo")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_vcm4y"]
script = ExtResource("4_dh2fs")
StringReply = "You catch a quick smirk from him, it is almost instantly hiden as the Baron shifts the conversation."
OptionName = "It was the right thing to do"
Branch = SubResource("Resource_uvn1n")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_xgvp6"]
script = ExtResource("4_dh2fs")
StringReply = "You catch a quick smirk from him, it is almost instantly hiden as the Baron shifts the conversation."
OptionName = "I wouldn't expect you to understand..."
Branch = SubResource("Resource_uvn1n")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_h6gft"]
script = ExtResource("4_fnrm0")
Text = "You reach a small shack and go in, through the stairs that lead to the basement, behind a whole in the wall, through a small tunnel and finaly reach a house."

[sub_resource type="Resource" id="Resource_rihir"]
script = ExtResource("4_fnrm0")
Text = "This is probably where this \"Baron\" receides. You wander what he wants from you, they dont look like the people that the empire would allay with."

[sub_resource type="Resource" id="Resource_m1a4y"]
script = ExtResource("4_fnrm0")
Text = "Your eyes meet with a man in the middle of the room, huge cigar on his lips a glass of probably something really expensive on his hand."

[sub_resource type="Resource" id="Resource_3prh3"]
script = ExtResource("4_fnrm0")
Text = "He stands up to greet you \"Ahhh the mesaiah people, he's arrived. Bow down your heads to his majesty\". You feel the mockery of his voice and its confirmed by the room bursting on a huge laughter."

[sub_resource type="Resource" id="Resource_6xcc7"]
script = ExtResource("4_fnrm0")
Text = "\"I am sorry for the joke master, but it was too obvious to let go. Please have a seat, we have an urgent mater to discuss\""

[sub_resource type="Resource" id="Resource_jo0hp"]
script = ExtResource("4_fnrm0")
Text = "\"I hear you are making your way to Dormak, am i wrong ? What buisness do you have with such a place?\""

[sub_resource type="Resource" id="Resource_g1jws"]
script = ExtResource("4_fnrm0")
Text = "\"Who is asking, the words come out of your mouth almost at their own, but you feel that its reasonable request.\""

[sub_resource type="Resource" id="Resource_5avmm"]
script = ExtResource("4_fnrm0")
Text = "\"Ahh aint that right, Introductions are in order. People aroung here call me that Baron, i take care of folk around here.\""

[sub_resource type="Resource" id="Resource_b5c5j"]
script = ExtResource("4_fnrm0")
Text = "\"With the situation being as it is... i could blame you \"freedom fighters\" for this. It was all fine and dandy before you guys decided to rise up, and for what? Machines, aint that pitifull.\""

[sub_resource type="Resource" id="Resource_afior"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_h6gft"), SubResource("Resource_rihir"), SubResource("Resource_m1a4y"), SubResource("Resource_3prh3"), SubResource("Resource_6xcc7"), SubResource("Resource_jo0hp"), SubResource("Resource_g1jws"), SubResource("Resource_5avmm"), SubResource("Resource_b5c5j")])
Options = Array[ExtResource("3_fnrm0")]([SubResource("Resource_vcm4y"), SubResource("Resource_xgvp6")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_qwh1g"]
script = ExtResource("4_dh2fs")
StringReply = "\"Thank you master. Follow me...\". The figure had already turned its back on me before finishing the sentance. I follow it, soon the ship had already vanished from my vision as we get lost in the aleyways of the town."
OptionName = "Accept the figure's invitation"
Branch = SubResource("Resource_afior")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_6vrue"]
script = ExtResource("4_fnrm0")
Text = "The town seems almost empty, the gates of ship open, as the deffening sound of them hitting the ground bellow ends no sound follows."

[sub_resource type="Resource" id="Resource_t1w3f"]
script = ExtResource("4_fnrm0")
Text = "Once the dust setles down you see a lonely figure waiting for you. Checking the suroundings you make sure its safe an make your way to the figure."

[sub_resource type="Resource" id="Resource_omqh5"]
script = ExtResource("4_fnrm0")
Text = "\"The Baron wishes to see you master\", the figure's voice withered almost like the hiss of a snake."

[sub_resource type="Resource" id="Resource_6myxw"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_6vrue"), SubResource("Resource_t1w3f"), SubResource("Resource_omqh5")])
Options = Array[ExtResource("3_fnrm0")]([SubResource("Resource_fnrm0"), SubResource("Resource_qwh1g")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

