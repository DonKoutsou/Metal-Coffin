[ext_resource type="Resource" uid="uid://c6f3bxpe2rsxd" path="res://Resources/Captains/PlayerCaptains/Baron.tres" id="5_fnrm0"]
[ext_resource type="Script" uid="uid://dje5vrjyps8mt" path="res://Scenes/Map/MapSpot/Happenings/Happening.gd" id="5_igefk"]
[ext_resource type="Script" uid="uid://w3pbagqwci26" path="res://Scenes/Map/MapSpot/Happenings/DroneHappeningOption.gd" id="6_dh2fs"]

[sub_resource type="Resource" id="Resource_fnrm0"]
script = ExtResource("4_dh2fs")
StringReply = "Then i'm going to have to ask you to turn back and leave imidietly, you are not welcome in the town no more."
OptionName = "Dismiss the figure"
FinishDiag = true
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_dh2fs"]
script = ExtResource("4_fnrm0")
Text = "We must do what needs to be done tho, we cannot lose at any cost. We can't get soft now that we are so close."

[sub_resource type="Resource" id="Resource_igefk"]
script = ExtResource("4_fnrm0")
Text = "\"Aaahhhh\" the Baron yells in a celebratory gesture. You see him take a second glass out and fill it with a drink, he passes it to you and you take it. \"A celebratory drink is in order, to a fruitfull colaboration your majesty\"."

[sub_resource type="Resource" id="Resource_w6kjy"]
script = ExtResource("4_fnrm0")
Text = "You glasses cling and after you take a sip you leave it to the table and ask the figure to guide you to your ship. Reaching your ship you see your squad have already gathered outside trying to see where your are going to come from."

[sub_resource type="Resource" id="Resource_2dd2n"]
script = ExtResource("4_fnrm0")
Text = "Reaching them you see the relief in their faces. You hear a question from the crowd. \"What happened captain?\". \"I secured us some help. Questionable one that is, but help none the less\"."

[sub_resource type="Resource" id="Resource_n8mto"]
script = ExtResource("4_fnrm0")
Text = "After finishing the sentence you hear 3 ships take of nearby and after a while they land next to your ship, the Baron comes out and salutes you with a small grin on his face. At your services captain."

[sub_resource type="Resource" id="Resource_j03jq"]
script = ExtResource("4_fnrm0")
Text = "You signal all the crew to take their positions, your are leaving..."

[sub_resource type="Resource" id="Resource_50e5o"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_dh2fs"), SubResource("Resource_igefk"), SubResource("Resource_w6kjy"), SubResource("Resource_2dd2n"), SubResource("Resource_n8mto"), SubResource("Resource_j03jq")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_bpqwd"]
script = ExtResource("6_dh2fs")
Cpt = ExtResource("5_fnrm0")
OptionName = "Accept"
BranchContinuation = Array[ExtResource("2_4o3s8")]([SubResource("Resource_50e5o")])
Branch = SubResource("Resource_50e5o")
metadata/_custom_type_script = "uid://w3pbagqwci26"

[sub_resource type="Resource" id="Resource_a5i7n"]
script = ExtResource("4_fnrm0")
Text = "\"How pitifull, declinig help based on principles. Is that the world you guys want to build. The thing you havent thought is that we will still be here weather you win or not. You are only doing damage to your self with this decission.\""

[sub_resource type="Resource" id="Resource_g3lsv"]
script = ExtResource("4_fnrm0")
Text = "\"Dont let me see your face around this parts again.\" You are pushed out by the Baron's guard."

[sub_resource type="Resource" id="Resource_t3ljt"]
script = ExtResource("4_fnrm0")
Text = "The figure takes you back to your ship, the Baron's squad has created a parimeter around your ship stopping any of your crew from stepping out. Your crew is agitated thanks to your prolonged leave but are toned down once they see you."

[sub_resource type="Resource" id="Resource_6gnjm"]
script = ExtResource("4_fnrm0")
Text = "You signal all the crew to take their positions, your are leaving..."

[sub_resource type="Resource" id="Resource_isnp5"]
script = ExtResource("4_fnrm0")
Text = "You've kept everything that happened in that room to yourself. Is that really the best choice to make?"

[sub_resource type="Resource" id="Resource_ty2qr"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_a5i7n"), SubResource("Resource_g3lsv"), SubResource("Resource_t3ljt"), SubResource("Resource_6gnjm"), SubResource("Resource_isnp5")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_r4c8b"]
script = ExtResource("4_dh2fs")
StringReply = "You feel that vibe in the room getting hostile, you understand that people like the Baron will probably not take getting declined very easily. "
OptionName = "Decline"
BranchContinuation = Array[ExtResource("2_4o3s8")]([SubResource("Resource_ty2qr")])
Branch = SubResource("Resource_ty2qr")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_2a5kj"]
script = ExtResource("4_fnrm0")
Text = "The room is silent, you cant really remember if it fell silent just now or it always was. You feel everybody's gaze on you, testing you? Judging you?..."

[sub_resource type="Resource" id="Resource_sklrr"]
script = ExtResource("4_fnrm0")
Text = "Damn right you will, and we will assist you. We have a say in this war like it or not. I wont lie to you, i'm not interested in saving any one. The trick to winning on this life is staying on top."

[sub_resource type="Resource" id="Resource_tnkad"]
script = ExtResource("4_fnrm0")
Text = "And to stay on top i need to work with the winner, and i belive you are going to be successfull in your mission. I offer you 3 of my ships, i will personally command one of them. What say you."

[sub_resource type="Resource" id="Resource_uj2sl"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_2a5kj"), SubResource("Resource_sklrr"), SubResource("Resource_tnkad")])
Options = Array[ExtResource("3_fnrm0")]([SubResource("Resource_bpqwd"), SubResource("Resource_r4c8b")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_dg34r"]
script = ExtResource("4_fnrm0")
Text = "\"Hahahaha, no you will not. Not with that atitude, what happened to your spine? You expect to win a war with hope... Get out of here, i've waisted enough time on you"

[sub_resource type="Resource" id="Resource_5d4oj"]
script = ExtResource("4_fnrm0")
Text = "\"Dont let me see your face around this parts again.\" You are pushed out by the Baron's guard."

[sub_resource type="Resource" id="Resource_5ulj2"]
script = ExtResource("4_fnrm0")
Text = "The figure takes you back to your ship, the Baron's squad has created a parimeter around your ship stopping any of your crew from stepping out. Your crew is agitated thanks to your prolonged leave but are toned down once they see you."

[sub_resource type="Resource" id="Resource_1xxoi"]
script = ExtResource("4_fnrm0")
Text = "You signal all the crew to take their positions, your are leaving..."

[sub_resource type="Resource" id="Resource_mfmax"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_dg34r"), SubResource("Resource_5d4oj"), SubResource("Resource_5ulj2"), SubResource("Resource_1xxoi")])
metadata/_custom_type_script = "uid://d4i4t1fv5kyee"

[sub_resource type="Resource" id="Resource_jek72"]
script = ExtResource("4_dh2fs")
StringReply = "The Baron holds his gaze onto your own, you feel like he is trying to feel if you stand by your words."
OptionName = "We will reach it."
BranchContinuation = Array[ExtResource("2_4o3s8")]([SubResource("Resource_uj2sl")])
Branch = SubResource("Resource_uj2sl")
WorldviewCheck = 1
CheckDifficulty = 50
WorldViewCheckFailBranch = Array[ExtResource("2_4o3s8")]([SubResource("Resource_mfmax")])
WorldViewFailBranch = SubResource("Resource_mfmax")
metadata/_custom_type_script = "uid://ii12ceb6fgif"

[sub_resource type="Resource" id="Resource_02h6m"]
script = ExtResource("4_fnrm0")
Text = "\"Dont let me see your face around this parts again.\" You are pushed out by the Baron's guard."

[sub_resource type="Resource" id="Resource_stjgv"]
script = ExtResource("4_fnrm0")
Text = "The figure takes you back to your ship, the Baron's squad has created a parimeter around your ship stopping any of your crew from stepping out. Your crew is agitated thanks to your prolonged leave but are toned down once they see you."

[sub_resource type="Resource" id="Resource_1gcf5"]
script = ExtResource("4_fnrm0")
Text = "You signal all the crew to take their positions, your are leaving..."

[sub_resource type="Resource" id="Resource_0t6kv"]
script = ExtResource("2_4o3s8")
Texts = Array[ExtResource("4_fnrm0")]([SubResource("Resource_02h6m"), SubResource("Resource_stjgv"), SubResource("Resource_1gcf5")])
