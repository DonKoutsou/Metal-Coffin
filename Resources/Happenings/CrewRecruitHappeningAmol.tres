[sub_resource type="Resource" id="Resource_tlnwl"]
script = ExtResource("3_tlnwl")
Text = "Landing on the port after a while and the Chief officer offers you a tour to the city. He's spent part of his early adult life on this town and thinks a small walk will take the preasure out of you for a bit."

[sub_resource type="Resource" id="Resource_fhvmr"]
