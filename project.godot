; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metal Coffin"
config/version="0.7.401"
run/main_scene="uid://cqxnjihcai1kd"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://Assets/Logos/LogoIcon.png"
config/windows_native_icon="res://Assets/Logos/LogoIc.ico"
config/demo=true

[audio]

buses/default_bus_layout="uid://c3nyxeslcljc8"

[autoload]

MusicMan="*res://Scenes/GlobalManagers/Sound/music_manager.tscn"
UiSoundManager="*res://Scenes/GlobalManagers/Sound/ui_sound_manager.tscn"
Help="*res://Scenes/GlobalManagers/Helper/helper.tscn"
Save="*res://Scripts/Save/save_load_manager.gd"
TutorialManager="*res://Scenes/GlobalManagers/Tutorial/tutorial_manager.tscn"
AchMan="*res://Scenes/GlobalManagers/Tutorial/achievement_manager.gd"
PopupManager="*res://Scenes/GlobalManagers/PopupManager.tscn"
DispoisitionManager="*uid://cuad168v6mleh"
BeehaveGlobalMetrics="*uid://c3ktl6ontsdt7"
BeehaveGlobalDebugger="*uid://bl3ma400hpvsh"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="test"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/BurstParticles2D/plugin.cfg", "res://addons/beehave/plugin.cfg", "res://addons/cptcreator/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/yard/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Minigames/": "red",
"res://Resources/": "purple"
}

