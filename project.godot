[internationalization]

locale/translations=PackedStringArray("res://Localisations/LOC - Stat.english.translation", "res://Localisations/LOC - Cards.greek.translation", "res://Localisations/LOC - Cards.english.translation", "res://Localisations/LOC - Tutorial.english.translation", "res://Localisations/LOC - FlightManual.english.translation")
locale/test="en"
locale/locale_filter_mode=1

[layer_names]

2d_physics/layer_1="ShipBody"
2d_physics/layer_2="Radar"
2d_physics/layer_3="Spot"
2d_physics/layer_4="Dock"

[physics]

2d/run_on_separate_thread=true
3d/physics_engine="Dummy"
2d/solver/solver_iterations=4

[rendering]

occlusion_culling/bvh_build_quality=0
textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
2d/shadow_atlas/size=128
textures/default_filters/anisotropic_filtering_level=0
environment/ssao/quality=0
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/volumetric_fog/use_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
driver/default_filters/anisotropic_filtering_level=2
