script = ExtResource("1_a13ek")
Title = "Card recycling"
Text = "In situations where the ships energy has been depleted but it still has cards in its hand it is possible to manually discard these cards in exchange for some energy.\\nFor every 2 cards discarded the ship is awarded 1 energy."
Target = Array[int]([19])
