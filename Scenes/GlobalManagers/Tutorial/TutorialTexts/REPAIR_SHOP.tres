[resource]
script = ExtResource("1_iogjn")
Title = "Repair Bay"
Text = "In the Repair Bay you can buy repair parts for your fleet.\\nYou can see the hull condition of each of your ships and also their repair price. Buying all the nececary repair parts will allow the ship to slowly repair itself.\\nAfter buying the parts the fleet can depart and keep repairing on another port, bought ship parts stay with the ship."
metadata/_custom_type_script = "uid://451ovq2ynuka"
